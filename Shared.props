<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ============================================================
       LocalStarRuptureSDKRoot
       Root of the out-of-tree SDK checkout used by the
       "Local SDK ..." configurations: the StarRupture-Game-SDK
       repo cloned alongside this one, so it resolves to
       StarRupture-Game-SDK\ in the folder that holds this repo.
       Override from the command line or an environment variable to
       point at a checkout somewhere else:
         msbuild /p:LocalStarRuptureSDKRoot="D:\path\to\SDK\"
       Must end with a trailing backslash.
       ============================================================ -->
  <PropertyGroup Condition="'$(LocalStarRuptureSDKRoot)' == ''">
    <LocalStarRuptureSDKRoot>$(SolutionDir)..\StarRupture-Game-SDK\</LocalStarRuptureSDKRoot>
  </PropertyGroup>

  <!-- ============================================================
       StarRuptureSDKSourceDir
       Points to the SDK subdirectory containing Basic.cpp,
       CoreUObject_functions.cpp and Engine_functions.cpp for the
       active configuration.
       ============================================================ -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release'">
    <StarRuptureSDKSourceDir>$(SolutionDir)StarRupture SDK\Server\SDK\</StarRuptureSDKSourceDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Client Debug' Or '$(Configuration)' == 'Client Release'">
    <StarRuptureSDKSourceDir>$(SolutionDir)StarRupture SDK\Client\SDK\</StarRuptureSDKSourceDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Server Debug' Or '$(Configuration)' == 'Server Release'">
    <StarRuptureSDKSourceDir>$(SolutionDir)StarRupture SDK\Server\SDK\</StarRuptureSDKSourceDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Local SDK Client Debug' Or '$(Configuration)' == 'Local SDK Client Release'">
    <StarRuptureSDKSourceDir>$(LocalStarRuptureSDKRoot)Client\SDK\</StarRuptureSDKSourceDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Local SDK Server Debug' Or '$(Configuration)' == 'Local SDK Server Release'">
    <StarRuptureSDKSourceDir>$(LocalStarRuptureSDKRoot)Server\SDK\</StarRuptureSDKSourceDir>
  </PropertyGroup>

  <!-- ============================================================
       StarRuptureSDKConfigDir
       Additional include directories injected for Client/Server
       builds. Includes both the top-level override headers and the
       generated SDK sub-directory headers.
       ============================================================ -->
  <PropertyGroup Condition="'$(Configuration)' == 'Client Debug' Or '$(Configuration)' == 'Client Release'">
    <StarRuptureSDKConfigDir>$(SolutionDir)StarRupture SDK\Client\;$(SolutionDir)StarRupture SDK\Client\SDK\</StarRuptureSDKConfigDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Server Debug' Or '$(Configuration)' == 'Server Release'">
    <StarRuptureSDKConfigDir>$(SolutionDir)StarRupture SDK\Server\;$(SolutionDir)StarRupture SDK\Server\SDK\</StarRuptureSDKConfigDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Local SDK Client Debug' Or '$(Configuration)' == 'Local SDK Client Release'">
    <StarRuptureSDKConfigDir>$(LocalStarRuptureSDKRoot)Client\;$(LocalStarRuptureSDKRoot)Client\SDK\</StarRuptureSDKConfigDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Local SDK Server Debug' Or '$(Configuration)' == 'Local SDK Server Release'">
    <StarRuptureSDKConfigDir>$(LocalStarRuptureSDKRoot)Server\;$(LocalStarRuptureSDKRoot)Server\SDK\</StarRuptureSDKConfigDir>
  </PropertyGroup>

  <!-- ============================================================
       MODLOADER_CLIENT_BUILD / MODLOADER_SERVER_BUILD
       Injected into PreprocessorDefinitions for all ClCompile items
       so source files can use:
         #if defined(MODLOADER_CLIENT_BUILD)   ...client-only code...
         #elif defined(MODLOADER_SERVER_BUILD)  ...server-only code...
         #else                                  ...generic fallback...
         #endif
       Legacy Debug / Release configurations get neither define,
       matching the #else fallback documented in scan_patterns.h.
       ============================================================ -->
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Client Debug' Or '$(Configuration)' == 'Client Release'">
    <ClCompile>
      <PreprocessorDefinitions>MODLOADER_CLIENT_BUILD;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Server Debug' Or '$(Configuration)' == 'Server Release'">
    <ClCompile>
      <PreprocessorDefinitions>MODLOADER_SERVER_BUILD;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Local SDK Client Debug' Or '$(Configuration)' == 'Local SDK Client Release'">
    <ClCompile>
      <PreprocessorDefinitions>MODLOADER_CLIENT_BUILD;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Local SDK Server Debug' Or '$(Configuration)' == 'Local SDK Server Release'">
    <ClCompile>
      <PreprocessorDefinitions>MODLOADER_SERVER_BUILD;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- ============================================================
       MODLOADER_BUILD_TAG
       Injected by CI via /p:ModLoaderBuildTag="release-YYYY.MM.DD-HHmmss".
       Plugins embed this in PluginInfo.version so the auto-updater
       can identify which build is installed.
       Dev / local builds get no define -> fallback "dev" in plugin code.
       ============================================================ -->
  <ItemDefinitionGroup Condition="'$(ModLoaderBuildTag)' != ''">
    <ClCompile>
      <PreprocessorDefinitions>MODLOADER_BUILD_TAG="$(ModLoaderBuildTag)";%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- ============================================================
       AUTOUPDATE_MANIFEST_URL
       Injected by CI per variant via /p:AutoUpdateManifestUrl="https://...".
       Baked into dwmapi.dll as the default manifest URL.
       Empty on dev builds -> auto-update disabled at runtime.
       ============================================================ -->
  <ItemDefinitionGroup Condition="'$(AutoUpdateManifestUrl)' != ''">
    <ClCompile>
      <PreprocessorDefinitions>AUTOUPDATE_MANIFEST_URL="$(AutoUpdateManifestUrl)";%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- ============================================================
       VerifyLocalStarRuptureSDK
       The Local SDK configurations pull their sources from outside
       the repo, so a missing checkout otherwise shows up as dozens
       of "cannot open source file" errors that never name the
       directory that is actually missing.
       ============================================================ -->
  <Target Name="VerifyLocalStarRuptureSDK" BeforeTargets="ClCompile"
          Condition="$(Configuration.StartsWith(&apos;Local SDK&apos;))">
    <Error Condition="!Exists(&apos;$(StarRuptureSDKSourceDir)Basic.cpp&apos;)"
           Text="Configuration &apos;$(Configuration)&apos; expects a StarRupture-Game-SDK checkout at &apos;$(LocalStarRuptureSDKRoot)&apos; but found no SDK there. Clone StarRupture-Game-SDK alongside this repo, or build with /p:LocalStarRuptureSDKRoot=X:\your\SDK\ (trailing backslash required)." />
  </Target>

</Project>