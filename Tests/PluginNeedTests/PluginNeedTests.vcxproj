<?xml version="1.0" encoding="utf-8"?>
<!--
  PluginNeedTests : a compile test for PLUGIN_NEEDS_INTERFACE in plugins\plugin_interface.h.
  See Tests/README.md.

  Each source file includes the live plugin_interface.h at one level (72 to 81, the
  default, and the loader's own host build) and static_asserts which host table
  members are visible and where they sit. Building the library is the test: a wrong
  #if, a shifted offset or a member that is visible when it should not be stops the
  compiler. Nothing here is linked or run, because the files declare different levels
  on purpose (a mix of levels in one plugin is a link error, which is the point of
  detect_mismatch).

  Like the other projects here it is in the solution but NOT built by "Build Solution"
  or by CI. Build the project file directly:

    msbuild Tests\PluginNeedTests\PluginNeedTests.vcxproj /p:Configuration="Client Release" /p:Platform=x64
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
